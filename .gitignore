# Python / environment
__pycache__/
*.py[cod]
.venv/
.env

# OS/editor
.DS_Store
.vscode/
.idea/

# Runtime logs: do not sync noisy session logs
data/logs/**
!data/logs/.gitkeep

# Temporary/cache files
data/tmp/**
data/cache/**

# Large binary artifacts: prefer Git LFS or manual sync
data/**/*.mp4
data/**/*.mov
data/**/*.bag
data/**/*.avi
data/**/*.h5
data/**/*.hdf5

# Local machine config overrides
config/*.local.yaml

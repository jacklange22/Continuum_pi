# Python / environment
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# OS/editor
.DS_Store
.vscode/
.idea/

# Runtime logs: do not sync noisy session logs
data/logs/**
!data/logs/.gitkeep

# Temporary/cache files
data/tmp/**
data/cache/**

# Generated experiment runs are synced Pi<->Mac with scripts/sync_pi_dataset.py,
# not through GitHub. This keeps git status usable while the Pi generates data.
data/experiments/**
!data/experiments/.gitkeep

# Historical safety net for already-tracked raw dataset files.
data/experiments/**/samples.jsonl
data/experiments/**/modeling_dataset_export.jsonl
data/experiments/**/modeling_dataset_legacy_compat.dat
data/experiments/**/workspace_map_visits.jsonl
data/experiments/**/raw_point_samples.jsonl
data/experiments/**/rejected_samples.jsonl
data/experiments/**/sample_failure_events.jsonl

# Large binary artifacts: prefer Git LFS or manual sync
data/**/*.mp4
data/**/*.mov
data/**/*.bag
data/**/*.avi
data/**/*.h5
data/**/*.hdf5

# Local machine config overrides
config/*.local.yaml

# Native build output
bin/

# Runtime data
data/trash/**
data/mock_experiments/**
data/mock_calibration/**
data/calibrations/*
!data/calibrations/.gitkeep
data/calibration/servo_calibration/**
data/logs/*
!data/logs/.gitkeep
data/registrations/*
!data/registrations/.gitkeep
data/tracker_captures/*
!data/tracker_captures/.gitkeep
data/runtime_tip_calibration/**
data/pivot_calibration/**

# Generated operator-readiness/export bundles
data/diagnostics/**
data/exports/**
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz

# Python / environment
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# OS/editor
.DS_Store
.vscode/
.idea/

# Runtime logs: do not sync noisy session logs
data/logs/**
!data/logs/.gitkeep

# Temporary/cache files
data/tmp/**
data/cache/**

# Large binary artifacts: prefer Git LFS or manual sync
data/**/*.mp4
data/**/*.mov
data/**/*.bag
data/**/*.avi
data/**/*.h5
data/**/*.hdf5

# Local machine config overrides
config/*.local.yaml

# Native build output
bin/

# Runtime data
data/trash/**
data/mock_experiments/**
data/mock_calibration/**
data/calibrations/*
!data/calibrations/.gitkeep
data/calibration/servo_calibration/**
data/logs/*
!data/logs/.gitkeep
data/registrations/*
!data/registrations/.gitkeep
data/tracker_captures/*
!data/tracker_captures/.gitkeep
data/runtime_tip_calibration/**
data/pivot_calibration/**

# Generated operator-readiness/export bundles
data/diagnostics/**
data/exports/**
data/**/*.zip
data/**/*.tar
data/**/*.tar.gz
